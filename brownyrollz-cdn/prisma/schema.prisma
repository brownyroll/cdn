// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  username  String
  fname     String
  lname     String
  isAdmin   Boolean    @default(false)
  provider  String
  createdAt DateTime   @default(now())
  accounts  Account[]
  sessions  Session[]
  loginLogs LoginLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  type              String
  access_token      String?
  token_type        String?
  expires_at        Int?
  refresh_token     String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  loginTime DateTime @default(now())
  provider  String
  user      User     @relation(fields: [userId], references: [id])
}
